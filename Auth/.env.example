AUTH_DATABASE_URL=sqlite+pysqlite:////tmp/pisigma_auth.db
AUTH_ISSUER=https://auth.pisigma.local
AUTH_HOST=127.0.0.1
AUTH_PORT=8090
AUTH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8787
AUTH_SPA_CALLBACK_URL=http://localhost:5173/auth/callback
# Optional deployment wiring (leave empty for product-agnostic Auth):
# AUTH_DEFAULT_AUDIENCES=myproduct
AUTH_DEFAULT_AUDIENCES=
AUTH_DEFAULT_ROLE=operator
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
