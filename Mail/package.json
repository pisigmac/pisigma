{
  "name": "pisigma-mail",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "PiSigma transactional mail product (SMTP + product keys)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply pisigma-mail --local",
    "db:remote": "wrangler d1 migrations apply pisigma-mail --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.7.2",
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
